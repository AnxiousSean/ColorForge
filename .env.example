# Ortex backend configuration. Copy to .env and fill in. NEVER commit real
# secrets. All values are read from the environment at startup.

# HTTP listen address.
ORTEX_LISTEN_ADDR=:8080

# PostgreSQL connection string. Required unless ORTEX_USE_MEMORY_STORE=true.
DATABASE_URL=postgres://ortex:ortex@localhost:5432/ortex?sslmode=disable

# Use the in-memory store instead of PostgreSQL (data is NOT persisted).
# Handy for local demos and tests.
ORTEX_USE_MEMORY_STORE=false

# LLM backend: mock | anthropic | openai. The scaffold ships with "mock".
ORTEX_LLM_PROVIDER=mock

# Number of worker goroutines per task (1-64).
ORTEX_WORKERS=3

# Session cookie signing secret (HMAC). Use a long random value (>=16 chars).
# Generate one with:  openssl rand -base64 32
ORTEX_SESSION_SECRET=change-me-to-a-long-random-string

# Web-console operator credential.
ORTEX_OPERATOR_USER=operator
# bcrypt hash of the operator password. Generate with:
#   go run ./cmd/hashpw 'your-password'
ORTEX_OPERATOR_PASSWORD_HASH=

# --- Only needed when ORTEX_LLM_PROVIDER is a live provider ---
# These are secrets: supply them via your secret store, never hardcode.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
